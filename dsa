# 5. Linear Search and Binary Search

```cpp
#include <iostream>
#include <string>
using namespace std;

class Searching {
public:
    int linearSearch(int a[], int n, int key, int& comparisons) {
        comparisons = 0;
        for (int i = 0; i < n; i++) {
            comparisons++;
            if (a[i] == key) return i;
        }
        return -1;
    }

    int binarySearch(int a[], int n, int key, int& comparisons) {
        int left = 0, right = n - 1;
        comparisons = 0;
        while (left <= right) {
            int mid = (left + right) / 2;
            comparisons++;
            if (a[mid] == key) return mid;
            if (a[mid] < key) left = mid + 1;
            else right = mid - 1;
        }
        return -1;
    }

    void sortArray(int a[], int n) {
        for (int i = 0; i < n - 1; i++)
            for (int j = i + 1; j < n; j++)
                if (a[i] > a[j]) {
                    int temp = a[i]; a[i] = a[j]; a[j] = temp;
                }
    }
};

int main() {
    int n, a[100], key, comparisons;
    cin >> n;
    for (int i = 0; i < n; i++) cin >> a[i];
    cin >> key;
    Searching s;
    cout << "Linear position: " << s.linearSearch(a, n, key, comparisons);
    cout << " Comparisons: " << comparisons << endl;
    s.sortArray(a, n);
    cout << "Binary position: " << s.binarySearch(a, n, key, comparisons);
    cout << " Comparisons: " << comparisons << endl;
    return 0;
}
