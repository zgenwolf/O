# 6. Selection Sort and Bubble Sort

```cpp
#include <iostream>
#include <string>
using namespace std;

class Sorting {
public:
    void selectionSort(float a[], int n) {
        for (int i = 0; i < n - 1; i++) {
            int min = i;
            for (int j = i + 1; j < n; j++)
                if (a[j] < a[min]) min = j;
            float temp = a[i]; a[i] = a[min]; a[min] = temp;
        }
    }

    void bubbleSort(float a[], int n) {
        for (int i = 0; i < n - 1; i++)
            for (int j = 0; j < n - i - 1; j++)
                if (a[j] > a[j + 1]) {
                    float temp = a[j]; a[j] = a[j + 1]; a[j + 1] = temp;
                }
    }

    void displayTopFive(float a[], int n) {
        for (int i = n - 1, count = 0; i >= 0 && count < 5; i--, count++)
            cout << a[i] << " ";
        cout << endl;
    }
};

int main() {
    int n;
    float a[100], b[100];
    cin >> n;
    for (int i = 0; i < n; i++) { cin >> a[i]; b[i] = a[i]; }
    Sorting s;
    s.selectionSort(a, n);
    s.bubbleSort(b, n);
    s.displayTopFive(a, n);
    s.displayTopFive(b, n);
    return 0;
}
```

# 7. Stack: Reverse a String and Check Palindrome

```cpp
#include <iostream>
#include <string>
using namespace std;

class StringStack {
public:
    string reverseString(string text) {
        char stack[1000];
        int top = -1;
        for (int i = 0; i < text.length(); i++) stack[++top] = text[i];
        string reversed = "";
        while (top >= 0) reversed += stack[top--];
        return reversed;
    }

    bool isPalindrome(string text) {
        string clean = "";
        for (int i = 0; i < text.length(); i++) {
            char ch = text[i];
            if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                (ch >= '0' && ch <= '9')) {
                if (ch >= 'A' && ch <= 'Z') ch = ch - 'A' + 'a';
                clean += ch;
            }
        }
        return clean == reverseString(clean);
    }
};

int main() {
    string text;
    getline(cin, text);
    StringStack s;
    cout << text << endl << s.reverseString(text) << endl;
    cout << (s.isPalindrome(text) ? "Palindrome" : "Not palindrome");
    return 0;
}
