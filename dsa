# 11. Pinnacle Club Singly Linked List

```cpp
#include <iostream>
#include <string>
using namespace std;

class PinnacleClub {
    struct Node {
        int prn;
        string name;
        Node* next;
    };
    Node* head;
public:
    PinnacleClub() { head = NULL; }

    void addPresident(int prn, string name) {
        Node* n = new Node{prn, name, head};
        head = n;
    }

    void addMember(int prn, string name) {
        if (head == NULL) { addPresident(prn, name); return; }
        Node* n = new Node{prn, name, head->next};
        head->next = n;
    }

    void addSecretary(int prn, string name) {
        Node* n = new Node{prn, name, NULL};
        if (head == NULL) { head = n; return; }
        Node* p = head;
        while (p->next != NULL) p = p->next;
        p->next = n;
    }

    void deletePresident() {
        if (head == NULL) return;
        Node* temp = head;
        head = head->next;
        delete temp;
    }

    void deleteMember(int prn) {
        if (head == NULL) return;
        if (head->prn == prn) { deletePresident(); return; }
        Node* p = head;
        while (p->next != NULL && p->next->prn != prn) p = p->next;
        if (p->next != NULL) {
            Node* temp = p->next;
            p->next = temp->next;
            delete temp;
        }
    }

    void deleteSecretary() {
        if (head == NULL) return;
        if (head->next == NULL) { deletePresident(); return; }
        Node* p = head;
        while (p->next->next != NULL) p = p->next;
        delete p->next;
        p->next = NULL;
    }

    int countMembers() {
        int count = 0;
        Node* p = head;
        while (p != NULL) { count++; p = p->next; }
        return count;
    }

    void searchMember(int prn) {
        Node* p = head;
        while (p != NULL && p->prn != prn) p = p->next;
        if (p == NULL) cout << "Member not found" << endl;
        else cout << p->prn << " " << p->name << endl;
    }

    void display() {
        Node* p = head;
        while (p != NULL) {
            cout << p->prn << " " << p->name << endl;
            p = p->next;
        }
    }

    void concatenate(PinnacleClub& second) {
        if (head == NULL) { head = second.head; second.head = NULL; return; }
        Node* p = head;
        while (p->next != NULL) p = p->next;
        p->next = second.head;
        second.head = NULL;
    }
};

int main() {
    PinnacleClub first, second;
    first.addPresident(1, "Asha");
    first.addMember(2, "Ravi");
    first.addSecretary(3, "Mina");
    second.addMember(4, "Jay");
    first.concatenate(second);
    first.display();
    cout << "Total members: " << first.countMembers();
    return 0;
}
```


# 12. Quick Sort

```cpp
#include <iostream>
using namespace std;

class QuickSort {
public:
    void swapNumbers(int& a, int& b) {
        int temp = a;
        a = b;
        b = temp;
    }

    int partition(int a[], int low, int high) {
        int pivot = a[high];
        int i = low - 1;

        for (int j = low; j < high; j++) {
            if (a[j] < pivot) {
                i++;
                swapNumbers(a[i], a[j]);
            }
        }

        swapNumbers(a[i + 1], a[high]);
        return i + 1;
    }

    void quickSort(int a[], int low, int high) {
        if (low < high) {
            int pivotPosition = partition(a, low, high);

            quickSort(a, low, pivotPosition - 1);
            quickSort(a, pivotPosition + 1, high);
        }
    }

    void display(int a[], int n) {
        for (int i = 0; i < n; i++)
            cout << a[i] << " ";
        cout << endl;
    }
};

int main() {
    int n, a[100];

    cin >> n;

    for (int i = 0; i < n; i++)
        cin >> a[i];

    QuickSort q;
    q.quickSort(a, 0, n - 1);
    q.display(a, n);

    return 0;
}
```

# 13. Ice-Cream Sets Using Linked List

```cpp
#include <iostream>
using namespace std;

class IceCreamSets {
    struct Node {
        int roll;
        Node* next;
    };

    Node* head;

public:
    IceCreamSets() {
        head = NULL;
    }

    bool contains(int roll) {
        Node* current = head;

        while (current != NULL) {
            if (current->roll == roll)
                return true;

            current = current->next;
        }

        return false;
    }

    void add(int roll) {
        if (contains(roll))
            return;

        Node* newNode = new Node;
        newNode->roll = roll;
        newNode->next = NULL;

        if (head == NULL) {
            head = newNode;
        } else {
            Node* current = head;

            while (current->next != NULL)
                current = current->next;

            current->next = newNode;
        }
    }

    int size() {
        int count = 0;
        Node* current = head;

        while (current != NULL) {
            count++;
            current = current->next;
        }

        return count;
    }

    void display() {
        Node* current = head;

        if (current == NULL) {
            cout << "None";
            return;
        }

        while (current != NULL) {
            cout << current->roll << " ";
            current = current->next;
        }
    }

    void intersection(IceCreamSets& other,
                      IceCreamSets& result) {
        Node* current = head;

        while (current != NULL) {
            if (other.contains(current->roll))
                result.add(current->roll);

            current = current->next;
        }
    }

    void unionSet(IceCreamSets& other,
                  IceCreamSets& result) {
        Node* current = head;

        while (current != NULL) {
            result.add(current->roll);
            current = current->next;
        }

        current = other.head;

        while (current != NULL) {
            result.add(current->roll);
            current = current->next;
        }
    }

    void eitherButNotBoth(IceCreamSets& other,
                          IceCreamSets& result) {
        Node* current = head;

        while (current != NULL) {
            if (!other.contains(current->roll))
                result.add(current->roll);

            current = current->next;
        }

        current = other.head;

        while (current != NULL) {
            if (!contains(current->roll))
                result.add(current->roll);

            current = current->next;
        }
    }
};

int main() {
    int total, n, roll;

    IceCreamSets vanilla;
    IceCreamSets butterscotch;
    IceCreamSets both;
    IceCreamSets either;
    IceCreamSets all;

    cin >> total;

    cin >> n;
    for (int i = 0; i < n; i++) {
        cin >> roll;
        vanilla.add(roll);
    }

    cin >> n;
    for (int i = 0; i < n; i++) {
        cin >> roll;
        butterscotch.add(roll);
    }

    vanilla.intersection(butterscotch, both);
    vanilla.eitherButNotBoth(butterscotch, either);
    vanilla.unionSet(butterscotch, all);

    cout << "Students who like both: ";
    both.display();
    cout << endl;

    cout << "Students who like either but not both: ";
    either.display();
    cout << endl;

    cout << "Students who like neither: "
         << total - all.size()
         << endl;

    return 0;
}
```
