# 3. String Operations

```cpp
#include <iostream>
#include <string>
using namespace std;

class StringOperations {
    bool isLetterOrDigit(char ch) {
        return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
               (ch >= '0' && ch <= '9');
    }
    char lowerCase(char ch) {
        if (ch >= 'A' && ch <= 'Z') return ch - 'A' + 'a';
        return ch;
    }
public:
    string longestWord(string text) {
        string word = "", longest = "";
        for (int i = 0; i <= text.length(); i++) {
            if (text[i] != ' ' && text[i] != '\0') word += text[i];
            else {
                if (word.length() > longest.length()) longest = word;
                word = "";
            }
        }
        return longest;
    }

    int frequency(string text, char target) {
        int count = 0;
        for (int i = 0; i < text.length(); i++)
            if (text[i] == target) count++;
        return count;
    }

    bool palindrome(string text) {
        int left = 0, right = static_cast<int>(text.length()) - 1;
        while (left < right) {
            while (left < right && !isLetterOrDigit(text[left])) left++;
            while (left < right && !isLetterOrDigit(text[right])) right--;
            if (lowerCase(text[left]) != lowerCase(text[right])) return false;
            left++;
            right--;
        }
        return true;
    }

    int substringIndex(string text, string part) {
        for (int i = 0; i <= text.length() - part.length(); i++) {
            int j = 0;
            while (j < part.length() && text[i + j] == part[j]) j++;
            if (j == part.length()) return i;
        }
        return -1;
    }

    void wordFrequencies(string text) {
        string words[100];
        int counts[100], total = 0;
        string word = "";
        for (int i = 0; i <= text.length(); i++) {
            if (text[i] != ' ' && text[i] != '\0') word += text[i];
            else if (word != "") {
                int found = -1;
                for (int j = 0; j < total; j++)
                    if (words[j] == word) found = j;
                if (found == -1) {
                    words[total] = word;
                    counts[total] = 1;
                    total++;
                } else counts[found]++;
                word = "";
            }
        }
        for (int i = 0; i < total; i++) cout << words[i] << " : " << counts[i] << endl;
    }
};

int main() {
    StringOperations s;
    string text, part;
    char target;
    getline(cin, text);
    cin >> target;
    cout << "Longest word: " << s.longestWord(text) << endl;
    cout << "Character frequency: " << s.frequency(text, target) << endl;
    cout << "Palindrome: " << (s.palindrome(text) ? "Yes" : "No") << endl;
    cin.ignore();
    getline(cin, part);
    cout << "Substring index: " << s.substringIndex(text, part) << endl;
    s.wordFrequencies(text);
    return 0;
}
```

