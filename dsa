# 1. Reverse a Number

```cpp
#include <iostream>
#include <string>
using namespace std;

class ReverseNumber {
public:
    int reverse(int number) {
        int answer = 0;
        while (number > 0) {
            int digit = number % 10;
            answer = answer * 10 + digit;
            number = number / 10;
        }
        return answer;
    }
};

int main() {
    int number;
    cin >> number;
    ReverseNumber r;
    cout << r.reverse(number);
    return 0;
}
