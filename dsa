# 10. Pizza Parlour Circular Queue

```cpp
#include <iostream>
#include <string>
using namespace std;

class PizzaQueue {
    string orders[5];
    int front, rear;
public:
    PizzaQueue() { front = -1; rear = -1; }

    void addOrder(string order) {
        if ((rear + 1) % 5 == front) cout << "Queue is full" << endl;
        else {
            if (front == -1) front = rear = 0;
            else rear = (rear + 1) % 5;
            orders[rear] = order;
            cout << "Order added: " << order << endl;
        }
    }

    void serveOrder() {
        if (front == -1) cout << "Queue is empty" << endl;
        else {
            cout << "Order served: " << orders[front] << endl;
            if (front == rear) front = rear = -1;
            else front = (front + 1) % 5;
        }
    }
};

int main() {
    PizzaQueue q;
    q.addOrder("Margherita");
    q.addOrder("Paneer");
    q.serveOrder();
    return 0;
}
