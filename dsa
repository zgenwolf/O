# 8. Check Balanced Brackets

```cpp
#include <iostream>
#include <string>
using namespace std;

class BracketStack {
public:
    bool isBalanced(string text) {
        char stack[1000];
        int top = -1;
        for (int i = 0; i < text.length(); i++) {
            char ch = text[i];
            if (ch == '(' || ch == '{' || ch == '[') stack[++top] = ch;
            else if (ch == ')' || ch == '}' || ch == ']') {
                if (top == -1) return false;
                char open = stack[top--];
                if ((ch == ')' && open != '(') ||
                    (ch == '}' && open != '{') ||
                    (ch == ']' && open != '[')) return false;
            }
        }
        return top == -1;
    }
};

int main() {
    string text;
    getline(cin, text);
    BracketStack b;
    cout << (b.isBalanced(text) ? "Well parenthesized" : "Not well parenthesized");
    return 0;
}
