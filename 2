#include <iostream>
#include <string>
using namespace std;
class BankAccount {
    string name = "Alice", type = "Savings";
    long long accountNumber = 1001;
    double balance = 5000;
public:
    void assignInitialValues() { name = "Alice"; accountNumber = 1001; type = "Savings"; balance = 5000; }
    void deposit(double amount) { if (amount > 0) balance += amount; }
    bool withdraw(double amount) { if (amount > 0 && amount <= balance) { balance -= amount; return true; } return false; }
    void display() const { cout << name << " " << balance << '\n'; }
};
int main() { BankAccount a; a.assignInitialValues(); a.deposit(1500); a.withdraw(2000); a.display(); }

