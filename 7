#include <iostream>
using namespace std;
class Rectangle { double length, width; public: Rectangle(): length(1),width(1) {} Rectangle(double l,double w): length(l),width(w) {} double area() const { return length*width; } };
class Square { double length, width; public: Square(): length(1),width(1) {} Square(double l,double w): length(l),width(w) {} double area() const { return length*width; } };
int main() { double rl,rw,sl,sw; cin >> rl >> rw >> sl >> sw; Rectangle r(rl,rw); Square s(sl,sw); cout << r.area() << '\n' << s.area() << '\n'; }

