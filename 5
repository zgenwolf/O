#include <iostream>
using namespace std;
class Rectangle { double length, width; public: Rectangle(): length(1), width(1) {} Rectangle(double l,double w): length(l),width(w) {} double area() const { return length*width; } };
class Triangle { double base, height; public: Triangle(): base(1),height(1) {} Triangle(double b,double h): base(b),height(h) {} double area() const { return 0.5*base*height; } };
int main() { double l,w,b,h; cin >> l >> w >> b >> h; Rectangle r(l,w); Triangle t(b,h); cout << r.area() << '\n' << t.area() << '\n'; }

