// ---------- Exp 1: Reverse a Number ----------
#include <iostream>
using namespace std;
int main() {
    long long num, rev = 0;
    cout << "Enter an N-digit number: ";
    cin >> num;
    long long n = (num < 0) ? -num : num;
    while (n > 0) {
        rev = rev * 10 + n % 10;
        n /= 10;
    }
    if (num < 0) rev = -rev;
    cout << "Reverse = " << rev << endl;
    return 0;
}


