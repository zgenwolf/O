// Problem 6: Square and Circle with constructors - User Input
#include <iostream>
using namespace std;

const double PI = 3.14159265358979;

class Square {
    double length, width;   // both equal for a square
public:
    Square() : length(1), width(1) {}
    Square(double l) : length(l), width(l) {}
    double area() const { return length * width; }
};

class Circle {
    double radius;
public:
    Circle() : radius(1) {}
    Circle(double r) : radius(r) {}
    double area() const { return PI * radius * radius; }
};

int main() {
    // Square
    Square s1;
    cout << "Square (default side 1) area = " << s1.area() << "\n";
    double side;
    cout << "Enter side of square: ";
    cin >> side;
    Square s2(side);
    cout << "Square area = " << s2.area() << "\n\n";

    // Circle
    Circle c1;
    cout << "Circle (default radius 1) area = " << c1.area() << "\n";
    double r;
    cout << "Enter radius of circle: ";
    cin >> r;
    Circle c2(r);
    cout << "Circle area = " << c2.area() << "\n";
    return 0;
}
